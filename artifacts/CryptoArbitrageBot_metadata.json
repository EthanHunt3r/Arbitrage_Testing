		"userdoc": {
			"kind": "user",
			"methods": {
				"approvedRouters(address)": {
					"notice": "Whitelisted DEX routers. Add more via setRouter()."
				},
				"balancerVault()": {
					"notice": "Balancer V2 Vault — zero-fee flash-loan provider."
				},
				"checkProfitability(address,address,uint256,address,address)": {
					"notice": "Simulate whether an arb would be profitable before submitting.         Invoke via eth_call — does not send a transaction.         Because Balancer V2 charges 0% flash-loan fees, repayAmount         equals loanAmount exactly; only gas costs remain (handled         off-chain in the Python monitor)."
				},
				"executeArbitrage(address,address,uint256,address,address)": {
					"notice": "Initiate a Balancer-flash-loan-powered arbitrage."
				},
				"receiveFlashLoan(address[],uint256[],uint256[],bytes)": {
					"notice": "Called by the Balancer Vault right after it sends the tokens."
				},
				"setRouter(address,bool)": {
					"notice": "Approve or revoke a DEX router."
				},
				"setSlippage(uint256)": {
					"notice": "Update slippage tolerance in basis points (max 500 = 5 %)."
				},
				"transferOwnership(address)": {
					"notice": "Transfer contract ownership."
				},
				"withdrawETH()": {
					"notice": "Withdraw any native ETH that ended up in this contract."
				},
				"withdrawToken(address,uint256)": {
					"notice": "Withdraw any ERC-20 token held by this contract."
				}
			},
			"notice": "Flash-loan-powered arbitrage across two Uniswap-V2-compatible DEXes,         using the Balancer V2 Vault as the zero-fee flash-loan provider. ┌──────────────────────────────────────────────────────────────┐ │  FLOW                                                        │ │  1. Owner calls executeArbitrage()                           │ │  2. Contract requests a flash loan from the Balancer Vault   │ │  3. Vault sends tokenA and calls receiveFlashLoan()          │ │  4. Swap tokenA → tokenB on dexA (buy leg  — cheaper price) │ │  5. Swap tokenB → tokenA on dexB (sell leg — higher price)  │ │  6. Repay exact loanAmount to Vault (Balancer fee = 0)       │ │  7. Profit stays in this contract                            │ │  8. Owner calls withdrawToken() to collect profit            │ └──────────────────────────────────────────────────────────────┘",
			"version": 1
		}
