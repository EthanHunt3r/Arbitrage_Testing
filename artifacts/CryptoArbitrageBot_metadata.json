						"routerB": "DEX router for the sell leg (tokenB → tokenA).",
						"tokenA": "Base token (borrowed and repaid).",
						"tokenB": "Intermediate token."
					},
					"returns": {
						"expectedProfit": "Gross profit in tokenA units (before gas costs).",
						"profitable": "    True when tokenAOut > loanAmount."
					}
				},
				"constructor": {
					"params": {
						"_balancerVault": "Balancer V2 Vault address.                        Use 0xBA12222222228d8Ba445958a75a0704d566BF2C8                        on Ethereum, Polygon, Arbitrum, and Optimism.",
						"_routerA": "First DEX router  (e.g. Uniswap V2).",
						"_routerB": "Second DEX router (e.g. SushiSwap)."
					}
				},
				"executeArbitrage(address,address,uint256,address,address)": {
					"params": {
						"loanAmount": "Amount of tokenA to borrow from the Balancer Vault.",
						"routerA": "DEX router for leg 1  (tokenA → tokenB, buy leg).",
						"routerB": "DEX router for leg 2  (tokenB → tokenA, sell leg).",
						"tokenA": "Token to borrow and end up with (base token).",
						"tokenB": "Intermediate token used across both swap legs."
					}
				},
				"receiveFlashLoan(address[],uint256[],uint256[],bytes)": {
					"details": "Must push tokens[i] + feeAmounts[i] back to the Vault before         returning.  On Balancer V2 feeAmounts are always 0, so         repayAmount == loanAmount exactly.",
					"params": {
						"amounts": "Borrowed amounts array.",
						"feeAmounts": "Fee array — currently always 0 on Balancer V2.",
						"tokens": "Borrowed token array (length 1).",
						"userData": "ABI-encoded (tokenA, tokenB, routerA, routerB)."
					}
				},
				"withdrawToken(address,uint256)": {
					"params": {
						"amount": "Amount to withdraw; pass 0 to withdraw the full balance.",
						"token": "Address of the token to withdraw."
					}
				}
			},
			"stateVariables": {
